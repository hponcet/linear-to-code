{
  "name": "linear-to-code",
  "displayName": "Linear in Editor",
  "description": "Get the entire Linear experience in your editor.",
  "icon": "resources/images/linear_dark.png",
  "version": "0.4.0",
  "publisher": "hpon",
  "repository": "https://github.com/hponcet/linear-to-code",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "------------ RUN ---------------------": "",
    "vscode:package": "vsce package",
    "ovsx:publish": "node scripts/ovsx-publish.cjs",
    "vscode:prepublish": "cross-env NODE_ENV=production npm run package",
    "compile": "webpack -c webpack.extension.js",
    "watch": "cross-env NODE_ENV=development sh -c 'ulimit -n 65536 2>/dev/null || true; npm-run-all --parallel watch:extension watch:react'",
    "watch:extension": "cross-env NODE_ENV=development webpack --watch -c webpack.extension.js",
    "watch:react": "cross-env NODE_ENV=development WEBVIEW_OUTPUT_PATH=dist-webviews-dev webpack --watch -c webpack.react.js",
    "package:webviews": "cross-env NODE_ENV=production webpack -c webpack.react.js --mode production --devtool hidden-source-map",
    "package:webviews:e2e": "cross-env NODE_ENV=production WEBVIEW_OUTPUT_PATH=e2e/dist webpack -c webpack.react.js --mode production --devtool hidden-source-map",
    "package": "webpack -c webpack.extension.js --mode production --devtool hidden-source-map && webpack -c webpack.react.js --mode production --devtool hidden-source-map",
    "analyze:webview": "cross-env NODE_ENV=production webpack -c webpack.react.js --json > dist/webpack-stats.json && webpack-bundle-analyzer dist/webpack-stats.json",
    "graphify:update": "graphify update .",
    "graphify:query": "graphify query",
    "------------ TESTS --------------------": "",
    "compile-tests": "tsc -p tsconfig.test.json --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "test:e2e": "npm run package:webviews:e2e && playwright test",
    "test:e2e:install": "playwright install chromium",
    "------------ DEV ----------------------": "",
    "preinstall": "$npm_execpath --silent run checknpm",
    "checknpm": "echo \"$npm_execpath\" | grep -q \"npm\" || (echo '⚠️  Use npm not yarn! ⚠️ ' && echo && exit 1)",
    "------------ CODE CHECKER -------------": "",
    "check:types": "tsc --project tsconfig.json --noEmit",
    "ts-coverage": "typescript-coverage-report -i '**/*.js' -c",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0 --cache --cache-location .cache/.eslintcache",
    "lint:fix": "npm run lint --fix .",
    "lint:indent": "prettier --check . --ignore-path .lint-ignore --cache --cache-location .cache/.prettiercache",
    "lint:indent:fix": "npx prettier --check . --ignore-path .lint-ignore --cache --cache-location .cache/.prettiercache --write",
    "lint:styles": "stylelint ./src/**/*.css ./src/**/*.scss --ignore-path .lint-ignore --max-warnings 0 --cache --cache-location .cache/.stylelintcache",
    "lint:styles:fix": "npm run lint:styles --fix",
    "lint:all": "npm run lint && npm run lint:indent && npm run lint:styles",
    "lint:all:fix": "npm run lint:fix; npm run lint:indent:fix; npm run lint:styles:fix",
    "prepare": "husky"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "linearToCode.mcp",
        "label": "Linear to Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linear-to-code-issues",
          "title": "Linear to Code",
          "icon": "resources/images/linear_dark.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "linearToCode.views.connect",
        "contents": "In order to use Linear to Code plugin, connect your Linear account to get started.\n[Connect to Linear](command:linearToCode.connect)",
        "when": "!linearToCode:isLinearAuthenticated && linearToCode:isLinearExtensionLoaded"
      }
    ],
    "views": {
      "linear-to-code-issues": [
        {
          "id": "linearToCode.views.connect",
          "name": "Connect to Linear",
          "icon": "resources/images/linear_dark.png",
          "when": "!linearToCode:isLinearAuthenticated"
        },
        {
          "id": "linearToCode.views.navigation",
          "name": "Workspace",
          "type": "webview",
          "when": "linearToCode:isLinearAuthenticated",
          "initialSize": 2
        },
        {
          "id": "linearToCode.views.myIssues",
          "name": "Issues",
          "icon": "resources/images/linear_dark.png",
          "when": "linearToCode:isLinearAuthenticated",
          "initialSize": 6
        },
        {
          "id": "linearToCode.views.pullRequests",
          "name": "Pull requests",
          "icon": "resources/images/linear_dark.png",
          "when": "linearToCode:isLinearAuthenticated",
          "initialSize": 2
        }
      ]
    },
    "commands": [
      {
        "command": "linearToCode.connect",
        "title": "Connect to Linear",
        "category": "Linear to Code",
        "enablement": "!linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.disconnect",
        "title": "Disconnect from Linear",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openIssue",
        "title": "Open Issue",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openIssueExternal",
        "title": "Open on Linear",
        "icon": "$(link-external)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.startWork",
        "title": "Start work on issue",
        "icon": "$(play)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.startWorkWithAgent",
        "title": "Start work with agent",
        "icon": "$(sparkle)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.reviewPullRequestWithAgent",
        "title": "Review with agent",
        "icon": "$(sparkle)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.configureBranch",
        "title": "Configure branch for issue",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.checkoutIssue",
        "title": "Switch to branch",
        "icon": {
          "light": "resources/images/checkout-light.svg",
          "dark": "resources/images/checkout-dark.svg"
        },
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.toggleViewMode",
        "title": "Select Issue View",
        "icon": "$(list-filter)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.searchIssues",
        "title": "Search Linear Issues",
        "icon": "$(search)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.createIssue",
        "title": "Create Issue",
        "icon": "$(add)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openPullRequest",
        "title": "Create pull request",
        "icon": "$(git-pull-request-create)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openSettings",
        "title": "Settings",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openSettingsTab",
        "title": "Open settings",
        "icon": "$(gear)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openCurrentBranchIssue",
        "title": "Open Issue for Current Branch",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated && linearToCode:isGitExtensionLoaded"
      },
      {
        "command": "linearToCode.commands.refreshPullRequests",
        "title": "Refresh pull requests",
        "icon": "$(refresh)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openPullRequestDiff",
        "title": "Open pull request diff",
        "icon": "$(git-compare)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated && linearToCode:isGitExtensionLoaded"
      },
      {
        "command": "linearToCode.commands.openPullRequestLinkedIssue",
        "title": "Open linked Linear issue",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.openPullRequestUrl",
        "title": "Open pull request on web",
        "icon": "$(link-external)",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated"
      },
      {
        "command": "linearToCode.commands.checkoutPullRequestBranch",
        "title": "Switch to source branch",
        "category": "Linear to Code",
        "enablement": "linearToCode:isLinearAuthenticated && linearToCode:isGitExtensionLoaded"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "linearToCode.commands.openIssue",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openIssueExternal",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.startWork",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.startWorkWithAgent",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.reviewPullRequestWithAgent",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.configureBranch",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.checkoutIssue",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openPullRequest",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openPullRequestDiff",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openPullRequestLinkedIssue",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openPullRequestUrl",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.checkoutPullRequestBranch",
          "when": "false"
        },
        {
          "command": "linearToCode.commands.openSettingsTab",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "linearToCode.commands.createIssue",
          "when": "view == linearToCode.views.myIssues",
          "group": "navigation"
        },
        {
          "command": "linearToCode.commands.refresh",
          "when": "view == linearToCode.views.myIssues",
          "group": "navigation"
        },
        {
          "command": "linearToCode.commands.searchIssues",
          "when": "view == linearToCode.views.myIssues",
          "group": "navigation"
        },
        {
          "command": "linearToCode.commands.openSettingsTab",
          "when": "view == linearToCode.views.myIssues",
          "group": "navigation",
          "args": [
            "workflow"
          ]
        },
        {
          "command": "linearToCode.commands.refreshPullRequests",
          "when": "view == linearToCode.views.pullRequests",
          "group": "navigation"
        },
        {
          "command": "linearToCode.commands.openSettingsTab",
          "when": "view == linearToCode.views.pullRequests",
          "group": "navigation",
          "args": [
            "git"
          ]
        }
      ],
      "view/item/context": [
        {
          "command": "linearToCode.commands.openIssue",
          "when": "viewItem =~ /^issueItem/",
          "group": "1open"
        },
        {
          "command": "linearToCode.commands.openIssueExternal",
          "when": "viewItem =~ /^issueItem/",
          "group": "1open"
        },
        {
          "command": "linearToCode.commands.startWork",
          "when": "viewItem == issueItem && linearToCode:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearToCode.commands.startWorkWithAgent",
          "when": "viewItem =~ /^issueItem/ && linearToCode:isCursor",
          "group": "2issueActions"
        },
        {
          "command": "linearToCode.commands.configureBranch",
          "when": "viewItem == issueItemWithBranch && linearToCode:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearToCode.commands.checkoutIssue",
          "when": "viewItem == issueItemWithBranch && linearToCode:isGitExtensionLoaded",
          "group": "2issueActions"
        },
        {
          "command": "linearToCode.commands.openPullRequest",
          "when": "viewItem == issueItemWithBranch && linearToCode:isGitExtensionLoaded && linearToCode:isGitProviderAuthenticated",
          "group": "2issueActions"
        },
        {
          "command": "linearToCode.commands.startWork",
          "when": "viewItem == issueItem && linearToCode:isGitExtensionLoaded",
          "group": "inline"
        },
        {
          "command": "linearToCode.commands.checkoutIssue",
          "when": "viewItem == issueItemWithBranch && linearToCode:isGitExtensionLoaded",
          "group": "inline"
        },
        {
          "command": "linearToCode.commands.openPullRequest",
          "when": "viewItem == issueItemWithBranch && linearToCode:isGitExtensionLoaded && linearToCode:isGitProviderAuthenticated",
          "group": "inline@1"
        },
        {
          "command": "linearToCode.commands.openIssueExternal",
          "when": "viewItem =~ /^issueItem/",
          "group": "inline@2"
        },
        {
          "command": "linearToCode.commands.openPullRequestDiff",
          "when": "viewItem =~ /^pullRequestItem/ && linearToCode:isGitExtensionLoaded",
          "group": "inline@1"
        },
        {
          "command": "linearToCode.commands.reviewPullRequestWithAgent",
          "when": "viewItem =~ /^pullRequestItem/ && linearToCode:isCursor",
          "group": "inline@0"
        },
        {
          "command": "linearToCode.commands.openPullRequestUrl",
          "when": "viewItem =~ /^pullRequestItem/",
          "group": "inline@2"
        },
        {
          "command": "linearToCode.commands.openPullRequestDiff",
          "when": "viewItem =~ /^pullRequestItem/ && linearToCode:isGitExtensionLoaded",
          "group": "1open"
        },
        {
          "command": "linearToCode.commands.reviewPullRequestWithAgent",
          "when": "viewItem =~ /^pullRequestItem/ && linearToCode:isCursor",
          "group": "1open"
        },
        {
          "command": "linearToCode.commands.checkoutPullRequestBranch",
          "when": "viewItem =~ /^pullRequestItem/ && linearToCode:isGitExtensionLoaded",
          "group": "1open"
        },
        {
          "command": "linearToCode.commands.openPullRequestUrl",
          "when": "viewItem =~ /^pullRequestItem/",
          "group": "1open"
        }
      ]
    },
    "keybindings": [
      {
        "command": "linearToCode.commands.openCurrentBranchIssue",
        "key": "ctrl+k b",
        "mac": "cmd+k b",
        "when": "!linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.openCurrentBranchIssue",
        "key": "ctrl+k ctrl+b",
        "mac": "cmd+k cmd+b",
        "when": "!linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.searchIssues",
        "key": "ctrl+k s",
        "mac": "cmd+k s",
        "when": "linearToCode:isLinearAuthenticated && !linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.searchIssues",
        "key": "ctrl+k ctrl+s",
        "mac": "cmd+k cmd+s",
        "when": "linearToCode:isLinearAuthenticated && !linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.createIssue",
        "key": "ctrl+k a",
        "mac": "cmd+k a",
        "when": "linearToCode:isLinearAuthenticated && !linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.createIssue",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "linearToCode:isLinearAuthenticated && !linearToCode:isCursor && !keybindingFocus"
      },
      {
        "command": "linearToCode.commands.openCurrentBranchIssue",
        "key": "ctrl+m b",
        "mac": "cmd+r b",
        "when": "linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.openCurrentBranchIssue",
        "key": "ctrl+m ctrl+b",
        "mac": "cmd+r cmd+b",
        "when": "linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.searchIssues",
        "key": "ctrl+m s",
        "mac": "cmd+r s",
        "when": "linearToCode:isLinearAuthenticated && linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.searchIssues",
        "key": "ctrl+m ctrl+s",
        "mac": "cmd+r cmd+s",
        "when": "linearToCode:isLinearAuthenticated && linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.createIssue",
        "key": "ctrl+m a",
        "mac": "cmd+r a",
        "when": "linearToCode:isLinearAuthenticated && linearToCode:isCursor"
      },
      {
        "command": "linearToCode.commands.createIssue",
        "key": "ctrl+m ctrl+a",
        "mac": "cmd+r cmd+a",
        "when": "linearToCode:isLinearAuthenticated && linearToCode:isCursor && !keybindingFocus"
      }
    ]
  },
  "configuration": {
    "title": "Linear to Code",
    "properties": {
      "linearToCode.autoRefreshIntervalSeconds": {
        "type": "number",
        "default": 180,
        "minimum": 0,
        "description": "Interval in seconds for automatically refreshing the My Issues tree view. Set to 0 to disable auto-refresh."
      }
    }
  },
  "extensionDependencies": [
    "linear.linear-connect",
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "1.62.1",
    "@types/eslint": "^9.6.1",
    "@types/fontkit": "^2.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.4.23",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "crypto-browserify": "^3.3.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "mini-css-extract-plugin": "^2.9.4",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.11",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.6.0",
    "process": "^0.11.10",
    "sass": "^1.97.2",
    "sass-loader": "^16.0.6",
    "source-map-loader": "^5.0.0",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.1.1",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.103.0",
    "webpack-bundle-analyzer": "^5.1.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "-": "^0.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.16",
    "@linear/sdk": "^70.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tiptap/core": "3.26.1",
    "@tiptap/extension-bubble-menu": "3.26.1",
    "@tiptap/extension-code": "3.26.1",
    "@tiptap/extension-code-block": "3.26.1",
    "@tiptap/extension-code-block-lowlight": "3.26.1",
    "@tiptap/extension-hard-break": "3.26.1",
    "@tiptap/extension-highlight": "3.26.1",
    "@tiptap/extension-horizontal-rule": "3.26.1",
    "@tiptap/extension-image": "3.26.1",
    "@tiptap/extension-link": "3.26.1",
    "@tiptap/extension-list": "3.26.1",
    "@tiptap/extension-mention": "3.26.1",
    "@tiptap/extension-subscript": "3.26.1",
    "@tiptap/extension-superscript": "3.26.1",
    "@tiptap/extension-table": "3.26.1",
    "@tiptap/extension-text-align": "3.26.1",
    "@tiptap/extensions": "3.26.1",
    "@tiptap/markdown": "3.26.1",
    "@tiptap/pm": "3.26.1",
    "@tiptap/react": "3.26.1",
    "@tiptap/starter-kit": "3.26.1",
    "@tiptap/suggestion": "3.26.1",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "emoji-picker-react": "^4.16.1",
    "fontkit": "^2.0.4",
    "lodash.throttle": "^4.1.1",
    "lowlight": "3.3.0",
